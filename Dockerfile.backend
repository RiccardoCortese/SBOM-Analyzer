FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        docker.io \
        docker-cli \
        git \
        libicu-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Backend/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY Backend/ .

EXPOSE 8000

CMD ["python", "-u", "server.py"]